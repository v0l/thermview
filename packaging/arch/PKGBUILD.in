# Generated from the checked-out release commit by build-package.sh.
pkgname=thermview
pkgver=__VERSION__
pkgrel=1
pkgdesc='Radiometric thermal image and CSQ video viewer'
arch=('x86_64')
url='https://github.com/alfiethology/thermview'
license=('GPL-3.0-or-later')
depends=('glibc' 'gcc-libs' 'gtk3' 'wayland' 'libxkbcommon' 'libxkbcommon-x11'
         'libx11' 'libxcb' 'libxcursor' 'libxi' 'libxrandr' 'libglvnd'
         'vulkan-icd-loader' 'hicolor-icon-theme' 'shared-mime-info' 'desktop-file-utils')
makedepends=('rust' 'cmake' 'pkgconf')
options=('!debug' '!lto')
source=("thermview-${pkgver}.tar.gz")
sha256sums=('__SOURCE_SHA256__')

build() {
    cd "$srcdir/thermview-$pkgver"
    cargo build --release --locked -p thermview
}

check() {
    cd "$srcdir/thermview-$pkgver"
    cargo test --workspace --locked
}

package() {
    cd "$srcdir/thermview-$pkgver"
    install -Dm755 target/release/thermview "$pkgdir/usr/bin/thermview"
    install -Dm644 packaging/linux/thermview.desktop "$pkgdir/usr/share/applications/thermview.desktop"
    install -Dm644 packaging/linux/thermview.xml "$pkgdir/usr/share/mime/packages/thermview.xml"
    install -Dm644 web/public/favicon.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/thermview.svg"
    install -Dm644 web/public/icon-192.png "$pkgdir/usr/share/icons/hicolor/192x192/apps/thermview.png"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/thermview/LICENSE"
    install -Dm644 README.md "$pkgdir/usr/share/doc/thermview/README.md"
}
